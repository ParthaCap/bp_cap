<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        title="Edit Business Partner">

        <content>

            <VBox class="sapUiSmallMargin">

                <Input
                    value="{businessPartnerName1}"
                    placeholder="Name" />

                <Input
                    value="{region}"
                    placeholder="Region" />

                <Input
                    value="{riskCategory}"
                    placeholder="Risk Category" />

            </VBox>

        </content>

        <beginButton>
            <Button
                text="Save"
                press="onSaveEdit" />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press="onCloseDialog" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>