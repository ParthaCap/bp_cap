<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        title="Create Business Partner">

        <VBox class="sapUiMediumMargin">

            <Input
                id="bpNumber"
                placeholder="BP Number"/>

            <Input
                id="bpName"
                placeholder="BP Name"/>

            <Input
                id="region"
                placeholder="Region"/>

            <Select id="riskCategory">

                <items>
                    <core:Item key="LOW" text="LOW"/>
                    <core:Item key="MEDIUM" text="MEDIUM"/>
                    <core:Item key="HIGH" text="HIGH"/>
                </items>

            </Select>

        </VBox>

        <beginButton>
            <Button
                text="Save"
                press="onSaveBP"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press="onCloseDialog"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>