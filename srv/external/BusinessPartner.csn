{
 "meta": {
  "creator": "cds-dk 10.0.7"
 },
 "$version": "2.0",
 "definitions": {
  "BusinessPartner.Address": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "ID": {
     "key": true,
     "type": "cds.UUID",
     "notNull": true,
     "@Core.ComputedDefaultValue": true
    },
    "address": {
     "type": "cds.String"
    },
    "street": {
     "type": "cds.String",
     "length": 60
    },
    "houseNumber": {
     "type": "cds.String",
     "length": 10
    },
    "addressLine1": {
     "type": "cds.String",
     "length": 60
    },
    "addressLine2": {
     "type": "cds.String",
     "length": 60
    },
    "addressLine3": {
     "type": "cds.String",
     "length": 60
    },
    "postalCode": {
     "type": "cds.String",
     "length": 10
    },
    "city": {
     "type": "cds.String",
     "length": 40
    },
    "countryKey_code": {
     "type": "cds.String",
     "length": 3,
     "@Common.Label": "{i18n>Country}",
     "@Common.ValueList.$Type": "Common.ValueListType",
     "@Common.ValueList.Label": "{i18n>Country}",
     "@Common.ValueList.CollectionPath": "Countries",
     "@Common.ValueList.Parameters": [
      {
       "$Type": "Common.ValueListParameterInOut",
       "LocalDataProperty": {
        "=": "countryKey_code"
       },
       "ValueListProperty": "code"
      },
      {
       "$Type": "Common.ValueListParameterDisplayOnly",
       "ValueListProperty": "name"
      }
     ],
     "doc": "{i18n>CountryCode.Description}"
    },
    "country": {
     "type": "cds.String",
     "length": 60
    },
    "poBox": {
     "type": "cds.String",
     "length": 10
    },
    "mobile": {
     "type": "cds.String",
     "length": 30
    },
    "telephone": {
     "type": "cds.String",
     "length": 30
    },
    "extension": {
     "type": "cds.String",
     "length": 10
    },
    "faxNumber": {
     "type": "cds.String",
     "length": 31
    },
    "email": {
     "type": "cds.String",
     "length": 241
    },
    "contactPerson": {
     "type": "cds.String",
     "length": 60
    },
    "countryKey": {
     "type": "cds.Association",
     "target": "BusinessPartner.Countries",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "countryKey",
        "code"
       ]
      },
      "=",
      {
       "ref": [
        "countryKey_code"
       ]
      }
     ],
     "@Common.Label": "{i18n>Country}",
     "doc": "{i18n>CountryCode.Description}"
    },
    "companyCodes": {
     "type": "cds.Association",
     "target": "BusinessPartner.CompanyCode",
     "cardinality": {
      "max": "*"
     },
     "keys": []
    }
   }
  },
  "BusinessPartner.BusinessPartner": {
   "kind": "entity",
