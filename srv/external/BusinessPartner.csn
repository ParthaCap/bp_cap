     "@Common.ValueList.CollectionPath": "Languages",
     "@Common.ValueList.Parameters": [
      {
       "$Type": "Common.ValueListParameterInOut",
       "LocalDataProperty": {
        "=": "language_code"
       },
       "ValueListProperty": "code"
      },
      {
       "$Type": "Common.ValueListParameterDisplayOnly",
       "ValueListProperty": "name"
      }
     ],
     "doc": "{i18n>LanguageCode.Description}"
    },
    "valueClaimExcluded": {
     "type": "cds.Boolean",
     "notNull": true,
     "default": {
      "val": false
     }
    },
    "isMarkedForDeletion": {
     "type": "cds.Boolean",
     "default": {
      "val": false
     }
    },
    "parentBusinessPartner": {
     "type": "cds.String",
     "length": 10
    },
    "companyCodeID": {
     "type": "cds.Association",
     "target": "BusinessPartner.CompanyCode",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "companyCodeID",
        "ID"
       ]
      },
      "=",
      {
       "ref": [
        "companyCodeID_ID"
       ]
      }
     ]
    },
    "addressID": {
     "type": "cds.Association",
     "target": "BusinessPartner.Address",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "addressID",
        "ID"
       ]
      },
      "=",
      {
       "ref": [
        "addressID_ID"
       ]
      }
     ]
    },
    "language": {
     "type": "cds.Association",
     "target": "BusinessPartner.Languages",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "language",
        "code"
       ]
      },
      "=",
      {
       "ref": [
        "language_code"
       ]
      }
     ],
     "@Common.Label": "{i18n>Language}",
     "doc": "{i18n>LanguageCode.Description}"
    },
    "businessPartnerContactPersons": {
     "type": "cds.Composition",
     "target": "BusinessPartner.BusinessPartnerContactPersons",
     "cardinality": {
      "max": "*"
     },
     "on": [
      {
       "ref": [
        "businessPartnerContactPersons",
        "businessPartner"
       ]
      },
      "=",
      {
       "ref": [
        "$self"
       ]
      }
     ]
    }
   }
  },
